---
import { usd, pct, bandLabel, bandColor } from '../lib/format';
import type { Plan } from '../lib/types';

export interface Props {
  plan: Plan;
  deposit: number;
}
const { plan, deposit } = Astro.props;
const invested = plan.legs.reduce((s, l) => s + l.amount_usd, 0);
const yearly = invested * (plan.blended_apy / 100);
const monthly = yearly / 12;
const daily = yearly / 365;
const riskBand = plan.portfolio_risk < 45 ? 'A' : plan.portfolio_risk < 60 ? 'B' : plan.portfolio_risk < 75 ? 'C' : 'D';
---
<section class="grid g2">
  <div class="hero">
    <div class="hero-label">Total balance</div>
    <div class="hero-amount num">{usd(deposit)}</div>
    <div class="hero-split">
      <div><span class="k">Working</span><span class="v num">{usd(invested)}</span></div>
      <div><span class="k">Withdrawable now</span><span class="v num">{usd(plan.idle_usd)}</span></div>
      <div><span class="k">Blended rate</span><span class="v num">{pct(plan.blended_apy)}</span></div>
    </div>
    <div class="hero-earn">
      <div><span class="k">Est. per year</span><span class="v num">{usd(yearly, 2)}</span></div>
      <div><span class="k">per month</span><span class="v num">{usd(monthly, 2)}</span></div>
      <div><span class="k">per day</span><span class="v num">{usd(daily, 2)}</span></div>
    </div>
    <p class="hero-note">
      Estimates use the venues' current realised rates. Rates are variable; this is not a fixed rate,
      not a deposit account and not a promise. Idle cash is kept deliberately: it is what makes "withdraw any time" true.
    </p>
  </div>

  <div class="card risk">
    <h2>Portfolio risk</h2>
    <div class="risk-head">
      <div class="num big">{plan.portfolio_risk.toFixed(0)}</div>
      <div class="small muted">/ 100 · {bandLabel[riskBand]}</div>
    </div>
    <div class="meter">
      <div class="meter-fill" style={`width:${Math.min(100, plan.portfolio_risk)}%;background:${bandColor[riskBand]}`}></div>
    </div>
    <div class="risk-breakdown small">
      <div><span class="muted">Weighted venue risk</span><span class="num">{plan.portfolio_risk_base.toFixed(1)}</span></div>
      <div><span class="muted">Shared-dependency penalty</span><span class="num">+{plan.correlation_penalty.toFixed(1)}</span></div>
    </div>
    <p class="small muted">
      Two venues that look different are not diversification if they are backed by the same collateral.
      The penalty is charged on shared dependencies — the August 2026 lesson, when one shared pool impaired
      every Blend backstop at once.
    </p>
  </div>
</section>

<style>
  .hero {
    background: linear-gradient(135deg, #C7481D 0%, #8F3112 100%);
    color: #fff; border-radius: var(--radius); padding: 22px 22px 18px;
  }
  .hero-label { font-size: 12px; opacity: 0.85; letter-spacing: 0.04em; text-transform: uppercase; }
  .hero-amount { font-size: 42px; font-weight: 700; letter-spacing: -0.03em; line-height: 1.1; margin-top: 2px; }
  .hero-split, .hero-earn { display: flex; gap: 26px; flex-wrap: wrap; margin-top: 16px; }
  .hero-earn { margin-top: 12px; padding-top: 12px; border-top: 1px solid rgba(255,255,255,0.18); }
  .hero-split .k, .hero-earn .k { display: block; font-size: 11px; opacity: 0.8; }
  .hero-split .v { font-size: 18px; font-weight: 600; }
  .hero-earn .v { font-size: 17px; font-weight: 600; }
  .hero-note { font-size: 11px; opacity: 0.75; margin: 14px 0 0; max-width: 52ch; line-height: 1.5; }

  .risk-head { display: flex; align-items: baseline; gap: 8px; }
  .big { font-size: 32px; font-weight: 700; }
  .meter { height: 8px; background: #F2EADB; border-radius: 999px; overflow: hidden; margin: 10px 0; }
  .meter-fill { height: 8px; border-radius: 999px; }
  .risk-breakdown { display: flex; flex-direction: column; gap: 4px; margin-bottom: 10px; }
  .risk-breakdown div { display: flex; justify-content: space-between; }
</style>
