---
import Base from '../layouts/Base.astro';
import Dashboard from '../components/Dashboard.astro';
import { api } from '../lib/api';

const [meta, network, health] = await Promise.all([api.meta(), api.network(), api.health()]);
---
<Base
  title="Where your money is, what it earns, what could go wrong"
  subtitle="Savings that always sit where the rate is best, and a page that shows you the working: what you earn, where it is, and what we turned down to keep it there."
  network={network}
  meta={meta}
  updated={health?.venues_updated ?? null}
>
  <Dashboard deposit={1000} />
</Base>
