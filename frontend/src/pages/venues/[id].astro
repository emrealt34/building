---
import { href, venueSlug } from '../../lib/url';
import Base from '../../layouts/Base.astro';
import RiskBars from '../../components/RiskBars.astro';
import { api } from '../../lib/api';
import { pct, usd, compactUSD, sparkline } from '../../lib/format';

// Static hosting: one page per venue we know about at build time. The list comes
// from the same source the site uses (live API or snapshot), so a newly indexed
// venue appears on the next build without touching this file.
export async function getStaticPaths() {
  const list = await api.venues(1000);
  return (list?.venues ?? []).map((v) => ({
    params: { id: venueSlug(v.id) },
    props: { venueId: v.id },
  }));
}

const id = Astro.props.venueId as string;
const deposit = 1_000;
const [detail, hist, meta, network] = await Promise.all([
  api.venue(id, deposit),
  api.history(id, 90),
  api.meta(),
  api.network(),
]);
const v = detail!.venue;
const chart = hist?.points?.length ? sparkline(hist.points) : '';
const rows = hist?.points ?? [];
const avg = rows.length ? rows.reduce((s, p) => s + p.apy, 0) / rows.length : 0;
const min = rows.length ? Math.min(...rows.map((p) => p.apy)) : 0;
const max = rows.length ? Math.max(...rows.map((p) => p.apy)) : 0;
---
<Base title={v.label} subtitle="What it pays, how safe it is, and why we would or would not put your money here." network={network} meta={meta} updated={detail.as_of}>
  <div class="grid g2">
    <div class="card">
      <div class="rowtop">
        <div>
          <span class="k">Paying today</span>
          <div class="rate num">{pct(v.apy)}</div>
          <div class="small muted">
            {v.apy_reward > 0
              ? `${pct(v.apy_base)} from borrowers, ${pct(v.apy_reward)} in temporary rewards`
              : 'all of it paid by borrowers'}
            {v.apy_mean_30d ? ` · 30-day average ${pct(v.apy_mean_30d)}` : ''}
          </div>
        </div>
        <div class="pos">
          <div><span class="k">You could take out</span><span class="num">{compactUSD(v.capacity_usd)}</span></div>
          <div><span class="k">Most we would put here</span><span class="num">{usd(v.max_position_usd)}</span></div>
        </div>
      </div>

      <div class={`verdict ${v.eligible ? 'ok' : 'no'}`}>
        {v.eligible
          ? <>We would put money here today.</>
          : <><strong>We would not put money here:</strong> {v.refusal}</>}
      </div>

      {chart && (
        <div class="chart">
          <div class="chart-head small muted">
            <span>What it actually paid over 90 days</span>
            <span class="num">min {pct(min)} · avg {pct(avg)} · max {pct(max)}</span>
          </div>
          <div set:html={chart} />
        </div>
      )}
    </div>

    <RiskBars risk={v.risk} incidents={v.incidents} />
  </div>

  <div class="grid g2 stack">
    <div class="card">
      <h2>What it depends on</h2>
      <ul class="deps">
        {v.underlying.map((u) => (
          <li><span class="bull">•</span><span>{u}</span></li>
        ))}
      </ul>
      <h3 class="mt">What we checked</h3>
      <div class="kv small">
        <div><span>Independent audits</span><span class="num">{v.audits}{v.tier1_audit ? ' · tier-1' : ''}</span></div>
        <div><span>Running for</span><span class="num">{v.live_months} months</span></div>
        <div><span>Rules can be changed</span><span class="num">{v.upgradeable ? 'yes' : 'no'}</span></div>
        <div><span>Price feed</span><span class="num">{v.oracle ?? 'n/a'}</span></div>
        <div><span>Share of the rate that is temporary</span><span class="num">{Math.round(v.reward_dependence * 100)}%</span></div>
        <div><span>We know where the interest comes from</span><span class="num">{v.yield_source_verified ? 'yes' : 'no'}</span></div>
        <div><span>You can leave immediately</span><span class="num">{v.instant_exit ? 'yes' : 'no'}</span></div>
      </div>
    </div>

    <div class="card">
      <h2>What this page does not promise</h2>
      <p class="small muted">
        This is a judgement, not a recommendation. No score can see a brand-new bug, an issuer freezing a balance, or
        the people running a place changing its rules overnight. What it can do is price what is visible today, and
        stop new money going in when the numbers start to slip.
      </p>
      <p class="small muted">
        Every rate here was actually paid; none of it is promised. A place paying 6% can pay 3% next month — which is
        why we keep part of every balance free instead of chasing the top of the table.
      </p>
      <a class="link small" href={href('/evidence/')}>How much is switching actually worth? →</a>
    </div>
  </div>
</Base>

<style>
  .rowtop { display: flex; justify-content: space-between; gap: 18px; flex-wrap: wrap; }
  .k { font-size: 11px; text-transform: uppercase; letter-spacing: 0.06em; color: var(--muted); display: block; }
  .rate { font-size: 38px; font-weight: 700; letter-spacing: -0.02em; line-height: 1.15; }
  .pos { display: flex; flex-direction: column; gap: 6px; text-align: right; font-size: 13px; }
  .pos .num { font-weight: 600; display: block; }
  .verdict { margin-top: 14px; border-radius: 10px; padding: 10px 12px; font-size: 13px; }
  .verdict.ok { background: #EDF3EA; color: var(--brand-ink); border: 1px solid #D6E3CF; }
  .verdict.no { background: #F9E7E1; color: #7A2A10; border: 1px solid #E7C4B6; }
  .chart { margin-top: 14px; }
  .chart-head { display: flex; justify-content: space-between; margin-bottom: 4px; }
  .deps { list-style: none; margin: 0; padding: 0; font-size: 13px; }
  .deps li { display: flex; gap: 8px; padding: 3px 0; color: #4A3D2C; }
  .bull { color: var(--brand); }
  .mt { margin-top: 14px; }
  .kv { display: flex; flex-direction: column; gap: 4px; }
  .kv div { display: flex; justify-content: space-between; gap: 12px; border-bottom: 1px dashed #F3EBDB; padding: 5px 0; }
  .kv span:first-child { color: var(--muted); }
  .link { color: var(--brand); font-weight: 600; }
  .link:hover { text-decoration: underline; }
  .stack { margin-top: 14px; }
</style>
