---
import { href, venueHref } from '../../lib/url';
import Base from '../../layouts/Base.astro';
import VenueTable from '../../components/VenueTable.astro';
import { api } from '../../lib/api';
import { pct, compactUSD, bandColor } from '../../lib/format';

const deposit = Number(Astro.url.searchParams.get('deposit')) || 1_000;
const [venues, meta, network] = await Promise.all([api.venues(deposit), api.meta(), api.network()]);
const list = venues?.venues ?? [];
const eligible = list.filter((v) => v.eligible);
const refused = list.filter((v) => !v.eligible);
---
<Base
  title="Where your money can sit"
  subtitle="Every place that pays interest on dollars, judged on the same scale. Being on this list is not a recommendation — more than half of it is turned down on purpose."
  network={network}
  meta={meta}
  updated={venues?.as_of ?? null}
>
  <div class="grid g4">
    <div class="card stat"><span class="k">Places we watch</span><span class="v num">{list.length}</span></div>
    <div class="card stat"><span class="k">We use</span><span class="v num ok">{eligible.length}</span></div>
    <div class="card stat"><span class="k">We turn down</span><span class="v num bad">{refused.length}</span></div>
    <div class="card stat"><span class="k">Biggest place we could use</span><span class="v num">{compactUSD(Math.max(0, ...list.map((v) => v.capacity_usd)))}</span></div>
  </div>

  <div class="stack">
    <VenueTable venues={list} />
  </div>

  <div class="stack card">
    <h2>Why what we turn down matters more than what we pick</h2>
    <p class="small muted">
      A list sorted by rate always rewards whoever is shouting loudest. So four kinds of place are turned down before
      anything is ranked: rates we cannot explain (is it borrowers paying, or a temporary promotion?); places too
      small for you to get out of quickly; places that are nearly out of lendable money; and rates several times
      their own normal level, which usually means a shortage rather than a real rate.
    </p>
    <table class="reasons">
      <thead><tr><th>Place</th><th class="right">Pays</th><th class="right">Safety</th><th>Why not</th></tr></thead>
      <tbody>
        {refused.map((v) => (
          <tr>
            <td><a class="name" href={venueHref(v.id)}>{v.label}</a></td>
            <td class="right num">{pct(v.apy)}</td>
            <td class="right num"><span class="band" style={`color:${bandColor[v.risk.band]}`}>{v.risk.band}</span></td>
            <td class="small muted">{v.refusal}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</Base>

<style>
  .stat { display: flex; flex-direction: column; gap: 4px; }
  .k { font-size: 11px; text-transform: uppercase; letter-spacing: 0.06em; color: var(--muted); }
  .v { font-size: 26px; font-weight: 700; }
  .ok { color: var(--brand); }
  .bad { color: var(--bad); }
  .stack { margin-top: 14px; }
  .name { font-weight: 600; }
  .name:hover { color: var(--brand); text-decoration: underline; }
  .band { font-weight: 700; }
  .reasons { margin-top: 10px; }
</style>
